NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Persistent library-only local replica set, created by npm run db:start.
MONGODB_URI=mongodb://127.0.0.1:27018/biblioteca?replicaSet=biblioteca-rs
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional: absolute path to mongod when it is not on PATH.
# MONGOD_PATH=C:/Program Files/MongoDB/Server/8.3/bin/mongod.exe

# Gmail delivery: enable 2-Step Verification and use a Gmail app password.
# preview stores emails locally for administrator inspection, without sending.
MAIL_TRANSPORT=preview
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- Production (see docs/DEPLOYMENT.md) ---
# NODE_ENV=production, MONGODB_URI (the local replica set above), a random JWT_SECRET and an https CLIENT_ORIGIN
# are required; the server refuses to start otherwise.
# Number of reverse proxies in front of the API (usually 1), so rate limits see real visitor IPs.
TRUST_PROXY=0
# true serves the built website (client/dist) from this server after `npm run build`.
SERVE_CLIENT=false
