{
  "name": "biblioteca",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-help.mjs",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:local": "node server/scripts/local-dev.js",
    "seed": "node server/scripts/seed.js",
    "bootstrap:admin": "node server/scripts/bootstrap-admin.js",
    "backup": "node server/scripts/backup.js",
    "build": "vite build",
    "lint": "eslint client server vite.config.ts playwright.config.ts vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "preview": "npm run preview --workspace client",
    "start": "node server/index.js",
    "start:server": "node server/index.js",
    "db:start": "npm run db:start --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "client",
    "server"
  ]
}
